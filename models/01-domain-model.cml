Domain ServiciosParaElHogar {

    domainVisionStatement = "Conectar hogares con proveedores confiables y coordinar trabajos puntuales para el hogar, desde la estructuración de la necesidad hasta la terminación y la garantía."

    Subdomain CapturaYDiagnosticoDeTrabajos {
        type = CORE_DOMAIN
    }

    Subdomain OrquestacionDeTrabajos {
        type = CORE_DOMAIN
    }

    Subdomain ConfianzaDeProveedores {
        type = CORE_DOMAIN
    }

    Subdomain MatchingDeProveedores {
        type = CORE_DOMAIN
    }

    Subdomain RedDeProveedores {
        type = SUPPORTING_DOMAIN
    }

    Subdomain Cotizaciones {
        type = SUPPORTING_DOMAIN
    }

    Subdomain EvidenciaCalidadYGarantias {
        type = SUPPORTING_DOMAIN
    }

    Subdomain Reputacion {
        type = SUPPORTING_DOMAIN
    }

    Subdomain RiesgoYFraude {
        type = SUPPORTING_DOMAIN
    }

    Subdomain ProcesamientoDePagos {
        type = GENERIC_SUBDOMAIN
    }

    Subdomain IdentidadYAcceso {
        type = GENERIC_SUBDOMAIN
    }

    Subdomain Notificaciones {
        type = GENERIC_SUBDOMAIN
    }

}

Domain AtencionDeSiniestrosB2B2C {

    domainVisionStatement = "Coordinar solicitudes previamente aprobadas por partners como trabajos auditables, aplicando redes, SLA, límites y reglas particulares sin asumir la propiedad de la póliza ni de la decisión de cobertura."

    Subdomain EntradaDeSolicitudesDePartner {
        type = CORE_DOMAIN
    }

    Subdomain ReglasYOrquestacionDePartner {
        type = CORE_DOMAIN
    }

    Subdomain ElegibilidadParaRedDePartner {
        type = CORE_DOMAIN
    }

    Subdomain EvidenciaYAuditoria {
        type = SUPPORTING_DOMAIN
    }

    Subdomain FacturacionAPartners {
        type = SUPPORTING_DOMAIN
    }

}

Domain ServiciosRecurrentesParaElHogar {

    domainVisionStatement = "Conectar hogares con servicios recurrentes confiables mediante planes, horarios y continuidad de atención."

    Subdomain PlaneacionDeServicioRecurrente {
        type = CORE_DOMAIN
    }

    Subdomain GestionDeSuscripciones {
        type = SUPPORTING_DOMAIN
    }

    Subdomain CobroRecurrente {
        type = GENERIC_SUBDOMAIN
    }

}

Domain ServiciosFinancierosParaProveedores {

    domainVisionStatement = "Mejorar la inclusión financiera del proveedor convirtiendo su historial de trabajo verificado en servicios de crédito y acceso a infraestructura financiera."

    Subdomain ScoringDeProveedores {
        type = CORE_DOMAIN
    }

    Subdomain MicrocreditoParaProveedores {
        type = CORE_DOMAIN
    }

    Subdomain Wallet {
        type = GENERIC_SUBDOMAIN
    }

}
