ContextMap HogarDeLosAlpesEquiposAsIs {
	type = ORGANIZATIONAL
	state = AS_IS

	contains EquipoAsistenteIA
	contains EquipoDatosEIA
	contains EquipoPublicacionYBusqueda
	contains EquipoRegistro
	contains EquipoAcreditacion
	contains EquipoWorkflows
	contains EquipoCotizaciones
	contains EquipoIntegracionesB2B2C
	contains EquipoReglasDePartner
	contains EquipoPlataforma
	contains EquipoGestionDeAgentes
	contains EquipoCalidadYDisputas
	contains EquipoPagos
	contains EquipoFinanzasYTesoreria
	contains EquipoRiesgoYCumplimiento
	contains EquipoWalletYPrestamos

	EquipoWorkflows [P]<->[P] EquipoAsistenteIA {
		implementationTechnology = "Coordinacion obligatoria en cada release porque el asistente escribe el modelo del trabajo"
	}

	EquipoWorkflows [P]<->[P] EquipoCotizaciones {
		implementationTechnology = "Misma division y mismo modelo; el cambio de alcance atraviesa a ambos equipos"
	}

	EquipoWorkflows [P]<->[P] EquipoPublicacionYBusqueda {
		implementationTechnology = "La publicacion es un estado del sub-trabajo, de modo que ambos equipos tocan la misma tabla"
	}

	EquipoWorkflows [P]<->[P] EquipoIntegracionesB2B2C {
		implementationTechnology = "Cualquier cambio en el modelo del trabajo obliga a regresionar las mas de 30 integraciones"
	}

	EquipoWorkflows [P]<->[P] EquipoReglasDePartner {
		implementationTechnology = "Las reglas del partner viven dentro del motor de flujo que mantiene Workflows"
	}

	EquipoWorkflows [P]<->[P] EquipoGestionDeAgentes {
		implementationTechnology = "La consola de agentes escribe directamente sobre el modelo del trabajo"
	}

	EquipoWorkflows [P]<->[P] EquipoCalidadYDisputas {
		implementationTechnology = "Cierre, evidencia y disputa se resuelven en la misma transaccion del trabajo"
	}

	EquipoIntegracionesB2B2C [P]<->[P] EquipoReglasDePartner {
		implementationTechnology = "Misma division de Siniestros, mismo paquete de codigo y misma tabla de acuerdos"
	}

	EquipoRegistro [P]<->[P] EquipoAcreditacion {
		implementationTechnology = "El estado de verificacion es una columna de la tabla de proveedores que mantiene Registro"
	}

	EquipoPublicacionYBusqueda [P]<->[P] EquipoRegistro {
		implementationTechnology = "La asignacion depende del esquema de perfil, cobertura y disponibilidad"
	}

	EquipoPublicacionYBusqueda [P]<->[P] EquipoAcreditacion {
		implementationTechnology = "La elegibilidad se calcula leyendo el estado de acreditacion en linea"
	}

	EquipoRegistro [P]<->[P] EquipoCalidadYDisputas {
		implementationTechnology = "La reputacion se materializa como campo de la tabla de proveedores"
	}

	EquipoPagos [P]<->[P] EquipoWalletYPrestamos {
		implementationTechnology = "La billetera se construyo sobre el mismo esquema de pagos y ambos equipos comparten migraciones"
	}

	EquipoPlataforma [U]->[D] EquipoWorkflows {
		implementationTechnology = "Clases base, identidad y notificaciones de las que hereda todo el monolito"
	}

	EquipoPlataforma [U]->[D] EquipoRegistro {
		implementationTechnology = "El proveedor extiende la cuenta generica de plataforma"
	}

	EquipoPlataforma [U]->[D] EquipoIntegracionesB2B2C {
		implementationTechnology = "Las credenciales de los partners son cuentas tecnicas del esquema de identidad"
	}

	EquipoPlataforma [U]->[D] EquipoGestionDeAgentes {
		implementationTechnology = "Roles y permisos de los agentes definidos en el modelo de acceso generico"
	}

	EquipoDatosEIA [U]->[D] EquipoAsistenteIA {
		implementationTechnology = "Datos e IA aporta los modelos de diagnostico pero no despliega codigo propio"
	}

	EquipoWorkflows [U]->[D] EquipoPagos {
		implementationTechnology = "Pagos depende de las transiciones de estado del trabajo para retener y liberar"
	}

	EquipoWorkflows [U]->[D] EquipoFinanzasYTesoreria {
		implementationTechnology = "La facturacion al partner se deriva del historico de trabajos cerrados"
	}

	EquipoReglasDePartner [U]->[D] EquipoFinanzasYTesoreria {
		implementationTechnology = "Las tarifas comerciales se leen de la tabla de acuerdos del partner"
	}

	EquipoPagos [U]->[D] EquipoRiesgoYCumplimiento {
		implementationTechnology = "Riesgo consulta la base operativa de pagos en modo lectura y exporta a hoja de calculo"
	}

	EquipoAcreditacion [U]->[D] EquipoRiesgoYCumplimiento {
		implementationTechnology = "Cumplimiento arma sus reportes a partir de los expedientes de verificacion"
	}
}

BoundedContext EquipoAsistenteIA {
	type = TEAM
	domainVisionStatement = "Equipo Asistente IA, de la division Proveedores de Servicio bajo el CTO. Construye el agente conversacional que diagnostica el problema del hogar y crea el trabajo estructurado. Responsable del contexto Marketplace."
}

BoundedContext EquipoDatosEIA {
	type = TEAM
	domainVisionStatement = "Equipo Datos e IA bajo el CTO. Aporta modelos de diagnostico, priorizacion y deteccion de fraude dentro del codigo de otros equipos, sin unidad desplegable propia. Responsable del contexto Datos e Inteligencia Artificial."
}

BoundedContext EquipoPublicacionYBusqueda {
	type = TEAM
	domainVisionStatement = "Equipo Publicacion y Busqueda, de la division Proveedores de Servicio bajo el CTO. Publica oportunidades y encuentra la oferta elegible. Responsable del contexto Asignacion."
}

BoundedContext EquipoRegistro {
	type = TEAM
	domainVisionStatement = "Equipo Registro, de la division Proveedores de Servicio bajo el CTO. Mantiene perfil, servicios, cobertura, personal y disponibilidad del proveedor. Responsable del contexto Gestion de Proveedores."
}

BoundedContext EquipoAcreditacion {
	type = TEAM
	domainVisionStatement = "Equipo Acreditacion, de la division Proveedores de Servicio bajo el CTO. Verifica proveedores y tecnicos y los habilita por servicio y zona. Responsable del contexto Acreditacion y Elegibilidad."
}

BoundedContext EquipoWorkflows {
	type = TEAM
	domainVisionStatement = "Equipo Workflows, de la division Gestion de trabajos bajo el CTO. Dueno del motor de flujo y del modelo del Trabajo, y cuello de botella de coordinacion de toda la ingenieria. Responsable de los contextos Gestion de Trabajos y Orquestacion de Atencion del Siniestro."
}

BoundedContext EquipoCotizaciones {
	type = TEAM
	domainVisionStatement = "Equipo Cotizaciones, de la division Gestion de trabajos bajo el CTO. Responsable de la propuesta economica, las solicitudes de informacion y las visitas al predio, en el contexto Cotizaciones."
}

BoundedContext EquipoIntegracionesB2B2C {
	type = TEAM
	domainVisionStatement = "Equipo Integraciones B2B2C, de la division Siniestros bajo el CTO. Mantiene un adaptador por cada partner y la sincronizacion de estado. Responsable de los contextos Gestion de Siniestros y Gestion de Polizas y Coberturas."
}

BoundedContext EquipoReglasDePartner {
	type = TEAM
	domainVisionStatement = "Equipo Reglas de Partner, de la division Siniestros bajo el CTO. Define SLA, redes permitidas, umbrales y pasos de aprobacion. Responsable de los contextos Reglas de Partner, Reglas de Partner para Siniestros, Gestion de Proveedores Homologados y Evaluacion y Aprobacion de Siniestros."
}

BoundedContext EquipoPlataforma {
	type = TEAM
	domainVisionStatement = "Equipo Plataforma bajo el CTO. Provee identidad, acceso, notificaciones y las clases base compartidas por todo el monolito, de las que dependen los demas equipos."
}

BoundedContext EquipoGestionDeAgentes {
	type = TEAM
	domainVisionStatement = "Equipo Gestion de agentes bajo el COO. Opera y da soporte a los cerca de 100 agentes que coordinan manualmente el ciclo de vida de los trabajos. Responsable de los contextos Gestion de Ejecucion y Gestion de Evidencias."
}

BoundedContext EquipoCalidadYDisputas {
	type = TEAM
	domainVisionStatement = "Equipo Calidad y disputas bajo el COO. Responsable de la aceptacion, las disputas, las garantias y la reputacion, en el contexto Calidad, Garantias y Disputas."
}

BoundedContext EquipoPagos {
	type = TEAM
	domainVisionStatement = "Equipo Pagos, de la division Fintech bajo el CFO. Responsable del cobro, la retencion, la liberacion, la devolucion y la conciliacion, en el contexto Pagos y Liquidaciones."
}

BoundedContext EquipoFinanzasYTesoreria {
	type = TEAM
	domainVisionStatement = "Equipo Finanzas y Tesoreria bajo el CFO. Responsable de la facturacion a los partners B2B2C, en el contexto Cierre y Facturacion de Siniestros."
}

BoundedContext EquipoRiesgoYCumplimiento {
	type = TEAM
	domainVisionStatement = "Equipo Riesgo y cumplimiento bajo el CFO. Revisa el riesgo y el cumplimiento regulatorio de forma reactiva y manual sobre la base de datos operativa."
}

BoundedContext EquipoWalletYPrestamos {
	type = TEAM
	domainVisionStatement = "Equipo Wallet y prestamos, de la division Fintech bajo el CFO. Construye la capacidad naciente de billetera y micropréstamos, correspondiente al dominio TO-BE de Servicios financieros para proveedores."
}
