ContextMap HogarDeLosAlpesAsIs {
	type = SYSTEM_LANDSCAPE
	state = AS_IS

	contains Marketplace
	contains DatosEInteligenciaArtificial
	contains GestionDeTrabajos
	contains Cotizaciones
	contains Asignacion
	contains GestionDeEjecucion
	contains GestionDeProveedores
	contains AcreditacionYElegibilidad
	contains ReglasDePartner
	contains CalidadGarantiasYDisputas
	contains PagosYLiquidaciones
	contains GestionDeSiniestros
	contains GestionDePolizasYCoberturas
	contains EvaluacionYAprobacionDeSiniestros
	contains OrquestacionDeAtencionDelSiniestro
	contains ReglasDePartnerParaSiniestros
	contains GestionDeProveedoresHomologados
	contains GestionDeEvidencias
	contains CierreYFacturacionDeSiniestros
	contains SistemasDePartner
	contains SistemaDeAntecedentesJudiciales
	contains RegistroMercantil
	contains EntidadesCertificadoras
	contains PasarelaDePagos

	DatosEInteligenciaArtificial [SK]<->[SK] Marketplace {
		implementationTechnology = "El asistente conversacional construye la solicitud y persiste la especificación del trabajo dentro del mismo proceso y la misma transacción"
	}

	Marketplace [SK]<->[SK] GestionDeTrabajos {
		implementationTechnology = "La solicitud del hogar instancia directamente las tablas trabajo y sub_trabajo del esquema compartido"
	}

	GestionDeTrabajos [SK]<->[SK] Cotizaciones {
		implementationTechnology = "Llamadas in-process y llave foránea sub_trabajo_id en el mismo esquema; un cambio de alcance reinicia la cotización en la misma transacción"
	}

	GestionDeTrabajos [SK]<->[SK] Asignacion {
		implementationTechnology = "La publicación y el proveedor asignado son columnas de estado del propio sub-trabajo"
	}

	GestionDeTrabajos [SK]<->[SK] GestionDeEjecucion {
		implementationTechnology = "El seguimiento de la ejecución escribe sobre las mismas filas del trabajo que gobierna el motor de flujo"
	}

	GestionDeTrabajos [SK]<->[SK] PagosYLiquidaciones {
		implementationTechnology = "La retención y la liberación de fondos se ejecutan en la misma transacción de la transición de estado del trabajo"
	}

	GestionDeTrabajos [SK]<->[SK] ReglasDePartner {
		implementationTechnology = "Las reglas de más de 30 partners están embebidas como condicionales dentro del motor de flujo del monolito"
	}

	GestionDeEjecucion [SK]<->[SK] Cotizaciones {
		implementationTechnology = "Una novedad dispara la recotización invocando directamente el servicio de cotizaciones dentro del monolito"
	}

	GestionDeEjecucion [SK]<->[SK] CalidadGarantiasYDisputas {
		implementationTechnology = "Disputas y garantías son tablas hijas del trabajo con borrado en cascada; el cierre y la aceptación ocurren en la misma transacción"
	}

	GestionDeEjecucion [SK]<->[SK] GestionDeEvidencias {
		implementationTechnology = "Las evidencias se adjuntan al trabajo desde la misma consola operativa y comparten el servidor de archivos de la aplicación"
	}

	Asignacion [SK]<->[SK] GestionDeProveedores {
		implementationTechnology = "El matching resuelve la oferta con un JOIN SQL directo sobre proveedor, servicio_declarado, cobertura y disponibilidad"
	}

	Asignacion [SK]<->[SK] AcreditacionYElegibilidad {
		implementationTechnology = "El filtro de elegibilidad consulta en línea el estado de acreditación; la regla de confianza vive dentro de la consulta de búsqueda"
	}

	Asignacion [SK]<->[SK] ReglasDePartner {
		implementationTechnology = "La red de proveedores permitida por el partner se evalúa dentro de la misma consulta que ordena los candidatos"
	}

	GestionDeProveedores [SK]<->[SK] AcreditacionYElegibilidad {
		implementationTechnology = "El estado de verificación es una columna de las tablas proveedor y técnico; el expediente y el perfil comercial son el mismo registro"
	}

	CalidadGarantiasYDisputas [SK]<->[SK] GestionDeProveedores {
		implementationTechnology = "La reputación se materializa como campo calculado sobre la tabla proveedor mediante un trigger"
	}

	GestionDeSiniestros [SK]<->[SK] GestionDePolizasYCoberturas {
		implementationTechnology = "La cobertura aplicable se resuelve leyendo las tablas de póliza dentro de la misma transacción de registro del siniestro"
	}

	GestionDeSiniestros [SK]<->[SK] EvaluacionYAprobacionDeSiniestros {
		implementationTechnology = "La decisión de aprobación es una columna de estado del propio siniestro; no existe contrato entre registro y evaluación"
	}

	GestionDeSiniestros [SK]<->[SK] OrquestacionDeAtencionDelSiniestro {
		implementationTechnology = "La orquestación lee y escribe el mismo registro de siniestro que mantiene el módulo de recepción"
	}

	OrquestacionDeAtencionDelSiniestro [SK]<->[SK] GestionDeTrabajos {
		implementationTechnology = "El siniestro aprobado instancia directamente un Trabajo y arrastra el identificador externo del partner al agregado"
	}

	OrquestacionDeAtencionDelSiniestro [SK]<->[SK] ReglasDePartnerParaSiniestros {
		implementationTechnology = "SLA, montos máximos y pasos de aprobación se evalúan como condicionales dentro del propio flujo de atención"
	}

	ReglasDePartnerParaSiniestros [SK]<->[SK] GestionDeProveedoresHomologados {
		implementationTechnology = "La red permitida y las homologaciones vigentes se leen de la misma tabla de acuerdo comercial del partner"
	}

	GestionDeProveedoresHomologados [SK]<->[SK] AcreditacionYElegibilidad {
		implementationTechnology = "La homologación del partner se persiste como columna adicional del expediente de acreditación de HdA"
	}

	ReglasDePartner [SK]<->[SK] ReglasDePartnerParaSiniestros {
		implementationTechnology = "Ambos conjuntos de reglas comparten la tabla acuerdo_partner y se despliegan juntos"
	}

	GestionDeEvidencias [SK]<->[SK] CierreYFacturacionDeSiniestros {
		implementationTechnology = "El cierre valida la completitud de la evidencia recorriendo las tablas hijas del trabajo dentro de la misma transacción"
	}

	CierreYFacturacionDeSiniestros [SK]<->[SK] GestionDeTrabajos {
		implementationTechnology = "La generación de ítems facturables recorre el histórico de trabajo y sub_trabajo con consultas directas sobre el esquema operativo"
	}

	GestionDeEjecucion [U,S]->[D,C] DatosEInteligenciaArtificial {
		implementationTechnology = "Consultas de solo lectura sobre la base de datos operativa para priorización y automatización; no existe canal de eventos"
		exposedAggregates = Ejecuciones
	}

	PagosYLiquidaciones [U,S]->[D,C] DatosEInteligenciaArtificial {
		implementationTechnology = "Extracción periódica desde el esquema de pagos para detección de fraude, con exportes a hoja de cálculo"
		exposedAggregates = IntencionesDePago
	}

	CalidadGarantiasYDisputas [U,S]->[D,C] DatosEInteligenciaArtificial {
		implementationTechnology = "Lectura directa de disputas y calificaciones para alimentar modelos analíticos"
		exposedAggregates = CasosDeCalidad
	}

	CierreYFacturacionDeSiniestros [U,S]->[D,C] PagosYLiquidaciones {
		implementationTechnology = "La liquidación consulta los ítems facturables generados por el cierre mediante acceso directo a sus tablas"
		exposedAggregates = FacturasAPartner
	}

	SistemasDePartner [U]->[D,CF] GestionDeSiniestros {
		implementationTechnology = "Un adaptador distinto por cada uno de los más de 30 partners, en REST, SOAP y archivos planos; el modelo externo entra sin traducción al dominio"
	}

	SistemasDePartner [U]->[D,CF] ReglasDePartner {
		implementationTechnology = "Las condiciones comerciales y de compliance de cada partner se replican tal cual en la configuración del monolito"
	}

	SistemaDeAntecedentesJudiciales [U]->[D,CF] AcreditacionYElegibilidad {
		implementationTechnology = "Consulta manual: un agente ingresa al portal de la Policía Nacional y transcribe el resultado al expediente"
	}

	RegistroMercantil [U]->[D,CF] AcreditacionYElegibilidad {
		implementationTechnology = "Consulta manual del registro mercantil y del estado legal en Cámara de Comercio; el certificado se adjunta como archivo"
	}

	EntidadesCertificadoras [U]->[D,CF] AcreditacionYElegibilidad {
		implementationTechnology = "Validación de títulos y matrículas con respuesta de 24 a 48 horas que bloquea el avance del expediente"
	}

	PasarelaDePagos [U]->[D,CF] PagosYLiquidaciones {
		implementationTechnology = "SDK invocado de forma síncrona dentro de la transacción de negocio; los códigos de estado de la pasarela se persisten en el modelo de dominio"
	}
}

BoundedContext Marketplace {
	type = FEATURE
	domainVisionStatement = "Conecta la demanda de los hogares con la oferta de proveedores mediante la solicitud y contratación de trabajos a través de la web y la aplicación móvil."
	implementationTechnology = "Módulo del monolito construido desde 2016"
	responsibilities = "Recibir la solicitud del hogar", "Presentar cotizaciones comparables", "Registrar la selección del proveedor", "Recoger la calificación del servicio"
	knowledgeLevel = CONCRETE

	Aggregate SolicitudesDeServicio {
		Entity SolicitudDeServicio {
			aggregateRoot
			String solicitudId
			String canal
			String clienteId
			String categoria
			String urgencia
			String ciudad
			String zona
			String direccion
			String estadoSolicitud
			Date fechaCreacion
			- List<EvidenciaInicial> evidencias
		}
		Entity EvidenciaInicial {
			String evidenciaId
			String tipoEvidencia
			String urlArchivo
		}
	}
}

BoundedContext DatosEInteligenciaArtificial {
	type = FEATURE
	domainVisionStatement = "Proporciona capacidades de datos e inteligencia artificial para el diagnóstico asistido de la necesidad del hogar, la priorización de casos, la detección de fraude y la automatización de tareas de otros procesos."
	implementationTechnology = "Servicio de modelos invocado desde el monolito, con acceso de lectura al esquema operativo"
	responsibilities = "Conducir el diálogo de diagnóstico", "Clasificar categoría y urgencia", "Priorizar casos", "Detectar señales de fraude"
	knowledgeLevel = CONCRETE

	Aggregate Diagnosticos {
		Entity Diagnostico {
			aggregateRoot
			String diagnosticoId
			String solicitudId
			String textoUsuario
			String categoriaSugerida
			String urgenciaSugerida
			double confianza
			Date fechaDiagnostico
			- List<TurnoConversacion> turnos
		}
		Entity TurnoConversacion {
			String turnoId
			String pregunta
			String respuesta
		}
	}

	Aggregate SenalesAnaliticas {
		Entity SenalAnalitica {
			aggregateRoot
			String senalId
			String tipoSenal
			String entidadReferida
			String identificadorReferido
			double puntaje
			Date fechaCalculo
		}
	}
}

BoundedContext GestionDeTrabajos {
	type = FEATURE
	domainVisionStatement = "Gestiona el ciclo de vida del Trabajo desde su creación hasta su ejecución y cierre, incluyendo sub-trabajos, actividades, dependencias y novedades."
	implementationTechnology = "Núcleo del monolito y punto de convergencia de todos los modulos"
	responsibilities = "Crear y descomponer el trabajo en sub-trabajos", "Determinar orden, paralelismo y bloqueos", "Gestionar transiciones de estado", "Registrar novedades y disparar recotización o reasignación"
	knowledgeLevel = CONCRETE

	Aggregate Trabajos {
		Entity Trabajo {
			aggregateRoot
			String trabajoId
			String origen
			String categoria
			String urgencia
			String estadoTrabajo
			String clienteId
			String partnerId
			String casoExternoId
			String ciudad
			String zona
			double costoTotal
			Date fechaCreacion
			Date fechaCierre
			- List<SubTrabajo> subTrabajos
			- List<Novedad> novedades
		}
		Entity SubTrabajo {
			String subTrabajoId
			String categoria
			String estadoSubTrabajo
			String proveedorAsignadoId
			String cotizacionAceptadaId
			double costoAcordado
			boolean bloqueante
			- List<Dependencia> dependencias
		}
		Entity Dependencia {
			String dependenciaId
			String dependeDeSubTrabajoId
			String tipoDependencia
		}
		Entity Novedad {
			String novedadId
			String tipoNovedad
			String detalle
			Date fechaDeteccion
			boolean exigeRecotizacion
			boolean exigeReasignacion
			boolean exigeAprobacionPartner
		}
	}

	Aggregate FlujosDeTrabajo {
		Entity FlujoDeTrabajo {
			aggregateRoot
			String flujoId
			String categoria
			int version
			- List<ActividadDelFlujo> actividades
		}
		Entity ActividadDelFlujo {
			String actividadId
			String nombreActividad
			int secuencia
			boolean bloqueante
			boolean paralelizable
		}
	}
}

BoundedContext Cotizaciones {
	type = FEATURE
	domainVisionStatement = "Gestiona la solicitud, recepción, evaluación y selección de cotizaciones asociadas a un Trabajo, incluyendo solicitudes de información adicional y visitas al predio."
	implementationTechnology = "Módulo del monolito acoplado por llave foránea al sub-trabajo"
	responsibilities = "Registrar cotizaciones por sub-trabajo", "Tramitar solicitudes de información adicional", "Agendar visitas al predio", "Versionar la cotización ante cambios de alcance"
	knowledgeLevel = CONCRETE

	Aggregate PropuestasDeCotizacion {
		Entity Cotizacion {
			aggregateRoot
			String cotizacionId
			String subTrabajoId
			String proveedorId
			int version
			double monto
			String moneda
			String estadoCotizacion
			Date vigenciaHasta
			boolean requiereVisita
			- List<LineaDeCotizacion> lineas
			- List<SolicitudDeInformacion> solicitudesDeInformacion
			- List<VisitaAlPredio> visitas
		}
		Entity LineaDeCotizacion {
			String lineaId
			String detalle
			double precioUnitario
			int cantidad
		}
		Entity SolicitudDeInformacion {
			String solicitudInformacionId
			String pregunta
			String respuesta
			Date fechaSolicitud
			Date fechaRespuesta
		}
		Entity VisitaAlPredio {
			String visitaId
			Date fechaAgendada
			String resultadoVisita
			boolean asistio
		}
	}
}

BoundedContext Asignacion {
	type = FEATURE
	domainVisionStatement = "Determina los proveedores candidatos y la asignación de trabajos considerando categoría, zona, disponibilidad, acreditación y reglas aplicables del partner."
	implementationTechnology = "Consultas SQL con múltiples JOIN sobre el esquema compartido de proveedores, acreditación y trabajos"
	responsibilities = "Publicar la oportunidad a la oferta elegible", "Calcular y ordenar candidatos", "Registrar la asignación", "Reabrir la publicación ante una reasignación"
	knowledgeLevel = CONCRETE

	Aggregate Publicaciones {
		Entity Publicacion {
			aggregateRoot
			String publicacionId
			String subTrabajoId
			String categoria
			String ciudad
			String zona
			String origen
			Date fechaPublicacion
			String estadoPublicacion
			- List<ProveedorCandidato> candidatos
		}
		Entity ProveedorCandidato {
			String candidatoId
			String proveedorId
			double puntajeAfinidad
			boolean acreditado
			boolean homologadoParaPartner
			boolean disponible
			double reputacion
		}
	}

	Aggregate ReglasDeElegibilidad {
		Entity ReglaDeElegibilidad {
			aggregateRoot
			String reglaId
			String categoria
			String zona
			boolean exigeAcreditacionCompleta
			String redPermitidaId
		}
	}
}

BoundedContext GestionDeEjecucion {
	type = FEATURE
	domainVisionStatement = "Coordina la ejecución y el seguimiento de los trabajos, incluyendo actividades, proveedores involucrados, novedades y cumplimiento de las condiciones acordadas."
	implementationTechnology = "Consola de back-office con acceso directo a las tablas operativas, operada por cerca de 100 agentes de gestión"
	responsibilities = "Monitorear el avance y los SLA", "Gestionar novedades y reasignaciones", "Coordinar entre cliente, proveedor y partner", "Registrar la terminación del trabajo"
	knowledgeLevel = CONCRETE

	Aggregate Ejecuciones {
		Entity Ejecucion {
			aggregateRoot
			String ejecucionId
			String trabajoId
			String estadoEjecucion
			String agenteResponsableId
			Date fechaInicio
			Date fechaTerminacion
			- List<SeguimientoDeActividad> seguimientos
			- List<IntervencionManual> intervenciones
		}
		Entity SeguimientoDeActividad {
			String seguimientoId
			String subTrabajoId
			String estadoActividad
			double porcentajeAvance
			Date fechaReporte
		}
		Entity IntervencionManual {
			String intervencionId
			String tipoIntervencion
			String motivo
			Date fechaIntervencion
			String agenteId
		}
	}
}

BoundedContext GestionDeProveedores {
	type = FEATURE
	domainVisionStatement = "Administra la red de profesionales y empresas, sus servicios declarados, cobertura geográfica, disponibilidad y reputación."
	implementationTechnology = "Módulo del monolito sobre el esquema relacional compartido, con más de 45.000 proveedores registrados"
	responsibilities = "Registrar y mantener el perfil del proveedor", "Administrar servicios declarados", "Administrar cobertura por ciudad y zona", "Administrar el personal técnico", "Administrar disponibilidad"
	knowledgeLevel = CONCRETE

	Aggregate Proveedores {
		Entity Proveedor {
			aggregateRoot
			String proveedorId
			String tipoProveedor
			String razonSocial
			String documentoTributario
			String correoContacto
			String estadoVerificacion
			double reputacion
			- List<ServicioDeclarado> serviciosDeclarados
			- List<ZonaDeCobertura> zonasDeCobertura
			- List<Tecnico> tecnicos
		}
		Entity ServicioDeclarado {
			String servicioId
			String categoria
			boolean activo
		}
		Entity ZonaDeCobertura {
			String ciudad
			String zona
		}
		Entity Tecnico {
			String tecnicoId
			String nombreCompleto
			String documentoIdentidad
			String estadoVerificacion
			boolean habilitadoParaAtender
		}
	}

	Aggregate Disponibilidades {
		Entity FranjaDeDisponibilidad {
			aggregateRoot
			String franjaId
			String proveedorId
			Date desde
			Date hasta
			boolean reservada
		}
	}
}

BoundedContext AcreditacionYElegibilidad {
	type = FEATURE
	domainVisionStatement = "Gestiona la verificación, acreditación y homologación de proveedores y determina para que trabajos pueden ser elegibles según servicio y zona."
	implementationTechnology = "Proceso mayoritariamente manual ejecutado por agentes humanos sobre portales externos; solo el expediente se persiste en el monolito"
	responsibilities = "Abrir y tramitar expedientes de verificación", "Verificar antecedentes por persona", "Validar títulos y certificaciones", "Verificar existencia legal de empresas", "Aprobar por servicio y zona", "Programar revalidaciones"
	knowledgeLevel = CONCRETE

	Aggregate ExpedientesDeVerificacion {
		Entity ExpedienteDeVerificacion {
			aggregateRoot
			String expedienteId
			String proveedorId
			String estadoExpediente
			Date fechaApertura
			String agenteAsignadoId
			- List<VerificacionDePersona> verificacionesDePersona
			- List<VerificacionDeEmpresa> verificacionesDeEmpresa
			- List<Credencial> credenciales
		}
		Entity VerificacionDePersona {
			String verificacionId
			String personaId
			String fuenteConsultada
			String resultado
			Date fechaConsulta
			String urlSoporte
		}
		Entity VerificacionDeEmpresa {
			String verificacionEmpresaId
			String numeroRegistroMercantil
			String estadoLegal
			String resultado
			Date fechaConsulta
		}
		Entity Credencial {
			String credencialId
			String tipoCredencial
			String entidadEmisora
			Date fechaEmision
			Date fechaVencimiento
			String estadoCredencial
		}
	}

	Aggregate AprobacionesPorServicioYZona {
		Entity AprobacionDeServicioYZona {
			aggregateRoot
			String aprobacionId
			String proveedorId
			String categoria
			String ciudad
			String zona
			boolean aprobado
			boolean habilitaSiniestros
			Date fechaRevalidacion
		}
	}
}

BoundedContext ReglasDePartner {
	type = FEATURE
	domainVisionStatement = "Gestiona las particularidades de aseguradoras, bancos y comercios: SLA, aprobaciones, montos, proveedores homologados, compliance y flujos específicos."
	implementationTechnology = "Reglas parcialmente en tablas de configuración y parcialmente embebidas como condicionales en el código del motor de flujo"
	responsibilities = "Definir la red de proveedores admitida", "Definir SLA por categoría", "Definir umbrales y pasos de aprobación", "Definir requisitos de compliance y auditoría", "Definir las tarifas del acuerdo comercial"
	knowledgeLevel = CONCRETE

	Aggregate AcuerdosDePartner {
		Entity AcuerdoDePartner {
			aggregateRoot
			String partnerId
			String tipoPartner
			String condicionesComerciales
			boolean exigeAuditoria
			- List<ReglaDeAprobacion> reglasDeAprobacion
			- List<AcuerdoDeNivelDeServicio> nivelesDeServicio
			- List<TarifaComercial> tarifas
		}
		Entity ReglaDeAprobacion {
			String reglaAprobacionId
			double montoMaximoSinAprobacion
			String rolAprobador
			boolean aplicaACambioDeAlcance
		}
		Entity AcuerdoDeNivelDeServicio {
			String nivelServicioId
			String categoria
			int minutosDeRespuesta
			int horasDeResolucion
		}
		Entity TarifaComercial {
			String tarifaId
			String categoria
			double valorUnitario
			Date vigenteDesde
		}
	}
}

BoundedContext CalidadGarantiasYDisputas {
	type = FEATURE
	domainVisionStatement = "Gestiona problemas de calidad, reclamaciones, garantías, disputas y compensaciones derivados de los trabajos ejecutados, y consolida la reputación del proveedor."
	implementationTechnology = "Tablas hijas del trabajo en el mismo esquema; los archivos de soporte se almacenan en el servidor de la aplicación"
	responsibilities = "Gestionar la aceptación y el cierre de calidad", "Tramitar disputas y compensaciones", "Administrar garantías posventa", "Consolidar calificaciones y reputación"
	knowledgeLevel = CONCRETE

	Aggregate CasosDeCalidad {
		Entity CasoDeCalidad {
			aggregateRoot
			String casoId
			String trabajoId
			String estadoCaso
			- List<Disputa> disputas
			- Garantia garantia
		}
		Entity Disputa {
			String disputaId
			String origenReclamo
			String motivo
			String resolucion
			boolean compensacionOtorgada
			Date fechaApertura
			Date fechaResolucion
		}
		Entity Garantia {
			String garantiaId
			int diasDeCobertura
			Date fechaVencimiento
			boolean reclamada
		}
	}

	Aggregate Reputaciones {
		Entity ReputacionDeProveedor {
			aggregateRoot
			String proveedorId
			double calificacionPromedio
			int trabajosCompletados
			int disputasPerdidas
			int inasistencias
			- List<Calificacion> calificaciones
		}
		Entity Calificacion {
			String calificacionId
			String trabajoId
			int estrellas
			String comentario
			Date fechaCalificacion
		}
	}
}

BoundedContext PagosYLiquidaciones {
	type = FEATURE
	domainVisionStatement = "Gestiona los pagos asociados a los trabajos, las liquidaciones a proveedores y los procesos de facturación con participantes y partners."
	implementationTechnology = "Módulo del monolito que invoca el SDK de la pasarela de forma síncrona dentro de la transacción de negocio"
	responsibilities = "Crear la intención de pago", "Retener fondos hasta la terminación", "Liberar el pago al proveedor", "Procesar devoluciones", "Conciliar con la pasarela", "Liquidar la facturación al partner"
	knowledgeLevel = CONCRETE

	Aggregate IntencionesDePago {
		Entity IntencionDePago {
			aggregateRoot
			String intencionPagoId
			String trabajoId
			String clienteId
			double monto
			String moneda
			String estadoPago
			String codigoPasarela
			- Retencion retencion
			- List<Liberacion> liberaciones
			- List<Devolucion> devoluciones
		}
		Entity Retencion {
			String retencionId
			double monto
			Date fechaRetencion
			Date fechaLiberacion
		}
		Entity Liberacion {
			String liberacionId
			String proveedorId
			double monto
			Date fechaLiberacion
		}
		Entity Devolucion {
			String devolucionId
			double monto
			String motivo
			Date fechaDevolucion
		}
	}

	Aggregate Conciliaciones {
		Entity Conciliacion {
			aggregateRoot
			String conciliacionId
			String referenciaPasarela
			double montoBruto
			double comisiones
			Date fechaLiquidacion
			String estadoConciliacion
		}
	}
}

BoundedContext GestionDeSiniestros {
