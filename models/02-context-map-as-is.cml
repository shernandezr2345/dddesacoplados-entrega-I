}

BoundedContext Plataforma {
	type = FEATURE
	domainVisionStatement = "Provee identidad, control de acceso, notificaciones y las clases base compartidas por todo el monolito, de las que dependen los demás módulos."
	implementationTechnology = "Paquete transversal del monolito del que heredan todos los módulos; no tiene despliegue propio"
	responsibilities = "Autenticar y autorizar a clientes, proveedores, agentes y partners", "Emitir notificaciones por correo, mensajería y aplicación", "Proveer las clases base y utilidades compartidas del monolito"
