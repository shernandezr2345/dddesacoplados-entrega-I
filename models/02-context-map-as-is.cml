			String estadoHomologacion
		}
	}
}

BoundedContext EvidenciaYAuditoria {
	type = FEATURE
	domainVisionStatement = "Gestiona la recopilación y consolidación de las evidencias que exige cada partner para soportar la ejecución, la auditoría y el cierre."
	implementationTechnology = "Archivos almacenados en el servidor de la aplicación y referenciados desde tablas hijas del trabajo"
	responsibilities = "Recolectar la evidencia exigida por el partner", "Validar completitud y formato", "Consolidar el expediente probatorio", "Sincronizar evidencias con el partner"
